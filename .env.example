# ─────────────────────────────────────────────────────────────────────────────
# School Admin Hub — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values below.
# The app will start without DATABASE_URL but all data endpoints will return
# empty results (0 counts, empty lists) until you set this up.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=

# (Optional) URL of the real Safe-School backend for auth proxying
# Default: http://localhost:3000
# BACKEND_URL=http://localhost:3000
